---
import '../styles/tokens.css';
import '../styles/header.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  googleFonts?: boolean;
}
const { title, googleFonts = false } = Astro.props;
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {googleFonts && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;600&display=swap" rel="stylesheet" />
      </>
    )}
    <Fragment set:html={`<script type="importmap">{"imports":{"three":"https://esm.sh/three@0.160.0"}}</script>`} />
  </head>
  <body>
    <canvas id="bg-canvas" aria-hidden="true"></canvas>
    <Header />
    <slot />
    <script is:inline type="module">
      import { initBackground } from "/js/background.js";
      const canvas = document.getElementById("bg-canvas");
      if (canvas) initBackground(canvas);
    </script>
  </body>
</html>
