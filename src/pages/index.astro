---
import Layout from '../layouts/Layout.astro';

const importmap = JSON.stringify({
  imports: { "three": "https://esm.sh/three@0.160.0" }
});
---
<Layout
  title="ふらる | hurarunium"
  extraStyles={["/css/link-buttons.css", "/css/hero.css", "/css/about.css", "/css/why.css", "/css/contact.css"]}
  importmap={importmap}
>
  <main class="site">
    <section class="hero" id="hero">
      <div class="hero__avatar" aria-hidden="true" data-hero-avatar></div>
      <h1 class="hero__name" data-bind="profile.name">ふらる</h1>
      <p class="hero__tagline" data-bind="profile.tagline">Wanderer of Worlds</p>
      <div class="hero__links link-buttons" data-hero-links></div>
      <div class="hero__scroll-hint" aria-hidden="true">↓</div>
    </section>

    <section class="about" id="about">
      <p class="section-label">ABOUT</p>
      <div class="about__body" data-about-body></div>
    </section>

    <section class="why" id="why">
      <div class="why__body" data-why-body></div>
    </section>

    <section class="contact" id="contact">
      <p class="contact__thanks" data-bind="contactNote">ここまで読んでくれて、ありがとうございます。</p>
      <div class="contact__links link-buttons" data-contact-links></div>
    </section>
  </main>
  <Fragment set:html={`
    <script type="module" src="/js/main.js"></script>
    <script type="module" src="/js/hero.js"></script>
    <script type="module" src="/js/about.js"></script>
    <script type="module" src="/js/why.js"></script>
    <script type="module" src="/js/contact.js"></script>
  `} />
</Layout>
