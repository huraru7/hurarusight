---
import Layout from '../layouts/Layout.astro';
import { siteName, profile, links } from '../data/content.ts';
import { getListedArticles } from '../utils/articles.ts';
import ArticleList from '../components/ArticleList.astro';

const recent = (await getListedArticles()).slice(0, 4);
const siteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: [profile.name, 'hurarunium', ...profile.aka],
  url: Astro.site?.href,
});
---
<Layout title={siteName} description="hurarunium(ふらるにうむ / a.k.a huraru)の個人サイト。ゲームを作ったり、考えたことを書いたりしています。">
  <script type="application/ld+json" slot="head" set:html={siteJsonLd} />
  <main class="container">
    <section class="intro">
      <h1 class="intro__name">{profile.name}</h1>
      <p class="intro__aka">a.k.a. {profile.aka.join(" / ")}</p>
      <p class="intro__tagline">{profile.tagline}</p>
      <p class="intro__text">{profile.intro}</p>
      <div class="intro__links">
        {links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
      </div>
    </section>

    <section>
      <h2 class="section-title">ARTICLES</h2>
      <ArticleList articles={recent} />
    </section>
  </main>
</Layout>
