---
import Layout from '../layouts/Layout.astro';
import LinkButtons from '../components/LinkButtons.astro';
import { content } from '../data/content.js';
import '../styles/hero.css';
import '../styles/link-buttons.css';
import '../styles/sections.css';

const { profile, about, why, contactNote } = content;
const lastWhyIdx = why.paragraphs.length - 1;
---
<Layout title="ふらる | hurarunium">
  <main class="site">
    <section class="hero" id="hero">
      <div class="hero__avatar" aria-hidden="true">{profile.name.charAt(0)}</div>
      <h1 class="hero__name">{profile.name}</h1>
      <p class="hero__tagline">{profile.tagline}</p>
      <div class="hero__links">
        <LinkButtons />
      </div>
      <div class="hero__scroll-hint" aria-hidden="true">↓</div>
    </section>

    <section class="about" id="about">
      <p class="section-label">ABOUT</p>
      <div class="about__body">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="why" id="why">
      <div class="why__body">
        {why.paragraphs.map((p, i) =>
          i !== lastWhyIdx
            ? <p>{p}</p>
            : <p>{p} <a class="why__link" href={why.linkHref}>{why.linkText}</a></p>
        )}
      </div>
    </section>

    <section class="contact" id="contact">
      <p class="contact__thanks">{contactNote}</p>
      <LinkButtons />
    </section>
  </main>
</Layout>
