---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatTicks, formatDate } from '../../utils/format.ts';
import '../../styles/garden.css';

function getCardSpan(thumbnail: string, thumbnailRatio: number | null, bodyLen: number, count: number) {
  if (thumbnail) {
    const r = thumbnailRatio ?? 1;
    if (r >= 0.8 && r <= 1.2) return { col: 2, row: 2 };
    if (r < 0.5)               return { col: 2, row: 1 };
    if (r > 1.5)               return { col: 1, row: 2 };
    return { col: 2, row: 1 };
  }
  if (bodyLen >= 100 && count >= 3) return { col: 2, row: 1 };
  return { col: 1, row: 1 };
}

function toPreview(bodyText: string, maxLen = 100): string {
  const plain = bodyText.replace(/[#*\->[\]()!`]/g, '').trim();
  const first = plain.split(/(?<=[。！？!?])/)[0]?.trim() ?? plain;
  return first.length > maxLen ? first.slice(0, maxLen) + '…' : first;
}

const articles = await getCollection('garden');
const allLogs  = await getCollection('gardenLog');

const cards = await Promise.all(
  articles.map(async (article) => {
    const logs = allLogs
      .filter((e) => e.id.startsWith(article.id + '/'))
      .sort((a, b) => b.id.localeCompare(a.id));

    const latest = logs[0];
    const count  = logs.length;
    const latestDate = latest?.id.split('/')[1] ?? '';
    const body = latest?.body ?? '';
    const bodyLen = body.replace(/[#*\->[\]()]/g, '').length;

    const preview = article.data.preview || toPreview(body);
    const { col, row } = getCardSpan(article.data.thumbnail, article.data.thumbnailRatio, bodyLen, count);

    return { article, count, latestDate, preview, col, row };
  })
);

const allTopics = ['all', ...new Set(articles.flatMap((a) => a.data.topics))];
---
<Layout title="庭 | ふらる" googleFonts={true}>
  <main class="garden-page">
    <a class="garden-page__back" href="/">← もどる</a>

    <header class="garden-header">
      <p class="garden-header__count">{cards.length}株</p>
      <h1 class="garden-header__title">Garden</h1>
      <p class="garden-header__desc">近況、エッセイ、メモ、かけら — いつも手入れしている思考の断片たち。</p>
    </header>

    <div class="garden-filters" data-garden-filters>
      <div class="garden-filter-row garden-filter-row--topics">
        <span class="garden-filter-label">TOPICS</span>
        <span class="garden-filter-sep" aria-hidden="true"></span>
        <button class="garden-scroll-btn" data-scroll-dir="left" aria-label="左へスクロール">&#8249;</button>
        <div class="garden-topics-scroll" data-topics-scroll>
          {allTopics.map((t) => (
            <button class={`garden-tab${t === 'all' ? ' is-active' : ''}`} data-topic={t}>{t}</button>
          ))}
        </div>
        <button class="garden-scroll-btn" data-scroll-dir="right" aria-label="右へスクロール">&#8250;</button>
      </div>
      <div class="garden-filter-row garden-filter-row--type">
        <div class="garden-type-dropdown">
          <button class="garden-type-trigger" data-type-trigger aria-expanded="false" aria-haspopup="listbox">
            <span data-type-label>All Types</span>
            <span class="garden-type-trigger__caret">▼</span>
          </button>
          <ul class="garden-type-menu" data-type-menu role="listbox" hidden>
            {['update', 'essay', 'note', 'fragment'].map((g) => (
              <li>
                <label class="garden-type-option">
                  <input class="garden-type-checkbox" type="checkbox" value={g} />
                  <span>{g}</span>
                </label>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="breath-grid">
      {cards.map(({ article, count, latestDate, preview, col, row }) => (
        <a
          class="garden-card"
          href={`/garden/${article.id}/`}
          style={`grid-column: span ${col}; grid-row: span ${row};`}
          data-genre={article.data.genre}
          data-slug={article.id}
          data-topics={(article.data.topics ?? []).join(',')}
        >
          <p class="garden-card__genre">{article.data.genre}</p>
          <h2 class="garden-card__title">{article.data.title}</h2>
          <p class="garden-card__body">{preview}</p>
          <p class="garden-card__meta">
            <span class="garden-card__date">{formatDate(latestDate)}</span>
            ・
            <span class="garden-card__ticks">{formatTicks(count)} ×{count}</span>
          </p>
        </a>
      ))}
    </div>
    <p class="garden-empty" data-garden-empty hidden>記事が見つかりませんでした</p>
  </main>

  <script is:inline type="module">
    import { applyReadStyles, restoreGardenScroll, saveGardenScroll } from '/js/world/memory.js';
    applyReadStyles();
    restoreGardenScroll();
    window.addEventListener('pagehide', saveGardenScroll);
  </script>
  <Fragment set:html={`<script type="module" src="/js/garden/filter.js"></script>`} />
</Layout>
