---
import Layout from '../../layouts/Layout.astro';

const importmap = JSON.stringify({
  imports: {
    "marked": "https://esm.sh/marked@12.0.2",
    "three": "https://esm.sh/three@0.160.0"
  }
});
---
<Layout
  title="庭 | ふらる"
  extraStyles={["/css/garden.css"]}
  googleFonts={true}
  importmap={importmap}
>
  <main class="garden-page">
    <a class="garden-page__back" href="/">← もどる</a>

    <header class="garden-header">
      <p class="garden-header__count" data-garden-count></p>
      <h1 class="garden-header__title">Garden</h1>
      <p class="garden-header__desc">近況、エッセイ、メモ、かけら — いつも手入れしている思考の断片たち。</p>
    </header>

    <div class="garden-filters" data-garden-filters></div>
    <div class="breath-grid" data-garden-list></div>
    <p class="garden-empty" data-garden-empty hidden>記事が見つかりませんでした</p>
  </main>

  <div class="garden-modal" id="garden-modal"
       role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true">
    <div class="garden-modal__overlay" data-modal-close></div>
    <div class="garden-modal__panel">
      <button class="garden-modal__close" data-modal-close aria-label="閉じる">✕</button>
      <div class="garden-modal__content">
        <p class="garden-article__genre" data-modal-genre></p>
        <h2 class="garden-article__title" id="modal-title" data-modal-title></h2>
        <button class="tending-header" data-modal-tending-header
                aria-expanded="false" aria-controls="modal-tending-log" hidden>
          <span data-modal-tending-label></span>
        </button>
        <hr />
        <div class="garden-article__body" data-modal-body></div>
        <div class="tending-log" id="modal-tending-log" data-modal-tending-log></div>
      </div>
    </div>
  </div>
  <Fragment set:html={`
    <script type="module" src="/js/garden/index.js"></script>
    <script type="module" src="/js/garden/filter.js"></script>
    <script type="module" src="/js/garden/modal.js"></script>
  `} />
</Layout>
