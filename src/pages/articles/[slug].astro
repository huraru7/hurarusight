---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteName } from '../../data/content.ts';
import { formatDate } from '../../utils/format.ts';
import { getPublishedArticles } from '../../utils/articles.ts';
import TagLinks from '../../components/TagLinks.astro';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<Layout
  title={`${article.data.title} | ${siteName}`}
  description={article.data.description}
  ogType="article"
  noindex={article.data.status === 'unlisted'}
>
  <main class="container page">
    <a class="back-link" href="/articles/">← 記事一覧に戻る</a>
    <article class="article">
      <h1 class="article__title">{article.data.title}</h1>
      <p class="article__date">{formatDate(article.data.date)}</p>
      <TagLinks tags={article.data.tags} class="article__tags" />
      <div class="article__body">
        <Content />
      </div>
    </article>
  </main>
</Layout>
